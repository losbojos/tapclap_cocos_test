{
  "compilerOptions": {
    "module": "commonjs",
    "lib": [ "es2015", "es2017", "dom" ],
    "target": "es5",
    "ignoreDeprecations": "5.0", // Для Cocos требуется еще target = "es5" поэтому пока оставляем, но убираем предупреждение данной строкой
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true, // отключает запись .js файлов, оставляя только проверку типов. Т.к. Cocos Creator сам компилирует TS
  },
  "exclude": [
    "node_modules",
    "library",
    "local",
    "temp",
    "build",
    "settings"
  ]
}